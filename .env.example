GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# "gemini" (cloud, fast, 20 req/day free tier) or "ollama" (local, no quota,
# ~7-8s/call - only used for claim extraction/explanation, never per
# evidence item). Requires `ollama serve` running locally.
LLM_BACKEND=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql+asyncpg://truth_user:truth_pass@localhost:5432/truth_db

SEMANTIC_SCHOLAR_API_KEY=

# Contact info sent to free APIs that reward identified requests with higher
# rate limits ("polite pool"). Not secrets - an email or URL is fine.
WIKIPEDIA_CONTACT=
OPENALEX_MAILTO=

GDELT_TIMEOUT_SECONDS=2.5
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=2.5
WIKIPEDIA_TIMEOUT_SECONDS=2.5
OPENALEX_TIMEOUT_SECONDS=2.5
WIKIDATA_TIMEOUT_SECONDS=2.0
EVIDENCE_DEADLINE_SECONDS=2.5
EVIDENCE_GRACE_SECONDS=0.25

APP_ENV=development
LOG_LEVEL=INFO
